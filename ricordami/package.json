{
  "name": "ricordami",
  "private": true,
  "type": "module",
  "description": "Promemoria che non ti lasciano scordare niente. PWA local-first, nessuna dipendenza a runtime.",
  "scripts": {
    "test": "TZ=Europe/Rome node --no-warnings --test test/*.test.mjs",
    "test:app": "node test/e2e/prova.mjs",
    "anteprime": "FOTO=docs/anteprime node test/e2e/prova.mjs",
    "www": "node scripts/prepara-www.mjs",
    "android:sync": "npm run www && npx cap sync android",
    "apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "test:nativo": "node test/e2e/nativo.mjs",
    "test:famiglia": "node --no-warnings test/e2e/famiglia.mjs",
    "server": "node --no-warnings server/locale.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "8.0.3",
    "@capawesome/capacitor-badge": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0"
  }
}
